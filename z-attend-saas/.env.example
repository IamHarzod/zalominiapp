# ==========================================
# Z-ATTEND SAAS - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

# --- APP SERVER CONFIG ---
PORT=3000
NODE_ENV=development

# --- DATABASE CONFIG (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=zattend_user
DB_PASSWORD=zattend_secret_password
DB_NAME=zattend_db
DB_ROOT_PASSWORD=zattend_root_password

# --- REDIS CONFIG (Redis 7) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=zattend_redis_password

# --- JWT AUTHENTICATION ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_TEMP_SECRET=your_temp_token_secret_here
JWT_TEMP_EXPIRES_IN=300s

# --- ZALO OPEN PLATFORM ---
ZALO_APP_ID=your_zalo_app_id_here
ZALO_APP_SECRET=your_zalo_app_secret_here

# --- SYSTEM DEFAULTS ---
DEFAULT_ALLOWED_RADIUS=30
QR_CODE_TTL_SECONDS=10
